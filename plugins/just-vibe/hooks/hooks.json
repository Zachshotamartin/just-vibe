{
  "hooks": {
    "PostToolUse": [{
      "matcher": "Write|Edit|MultiEdit|apply_patch",
      "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.mjs\"", "timeout": 30 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.mjs\"", "timeout": 30 }]
    }]
  }
}
