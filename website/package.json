{
  "name": "just-vibe-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:layout": "node scripts/layout-check.mjs",
    "test:motion": "node scripts/motion-check.mjs",
    "test:header": "node scripts/header-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@lucide/astro": "1.47.0",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1"
  }
}
