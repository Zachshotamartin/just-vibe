---
import Icon from '../components/Icon.astro';
import Base from './Base.astro';
import { docs } from '../lib/docs.mjs';
const { frontmatter } = Astro.props;
const { title, description } = frontmatter;
---

<Base title={`${title} — just-vibe docs`} description={description} section="docs">
  <div class="wrap detail-layout">
    <aside class="detail-sidebar">
      <a class="back-link" href="/docs/">
        <Icon name="arrow-left" /> Documentation
      </a>
      <nav aria-label="Documentation">
        {docs.map((doc) => (
          <a
            href={`/docs/${doc.slug}/`}
            aria-current={Astro.url.pathname === `/docs/${doc.slug}/` ? 'page' : undefined}
          >
            {doc.title}
          </a>
        ))}
      </nav>
    </aside>
    <article class="detail-body prose">
      <header data-reveal>
        <p class="eyebrow">The field guide</p>
        <h1>{title}</h1>
        <p class="detail-lede">{description}</p>
      </header>
      <slot />
    </article>
  </div>
</Base>
