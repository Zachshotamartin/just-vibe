---
import {
  ArrowUpRight,
  ArrowRight,
  ArrowLeft,
  Download,
  Search,
  Plus,
  X,
  Copy,
} from '@lucide/astro';

const icons = {
  'arrow-up-right': ArrowUpRight,
  'arrow-right': ArrowRight,
  'arrow-left': ArrowLeft,
  download: Download,
  search: Search,
  plus: Plus,
  x: X,
  copy: Copy,
};
interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}
const { name, size = 16, class: className = '' } = Astro.props;
const Glyph = icons[name];
---

<Glyph
  class={`icon ${className}`}
  size={size}
  stroke-width={1.7}
  aria-hidden="true"
  focusable="false"
/>
