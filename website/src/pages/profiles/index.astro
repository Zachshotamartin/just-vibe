---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import CatalogBrowser from '../../components/CatalogBrowser.astro';
import { profiles, families, familyName } from '../../lib/catalog.mjs';
const items = profiles.map((p) => ({
  ...p,
  group: p.family,
  groupName: familyName(p.family),
  search: [p.id, p.name, p.summary, familyName(p.family), ...p.priorities, ...p.workflows].join(
    ' ',
  ),
}));
---

<Base
  title="Engineering profiles — just-vibe"
  section="profiles"
  description="112 engineering profiles with task-specific priorities, decision guidance, and verification checks for your coding agent."
>
  <section class="wrap page-intro">
    <p class="eyebrow">The right perspective</p>
    <h1>
      Think like the role
      <br />
      the work needs.
    </h1>
    <p>
      {profiles.length} profiles across {families.length} disciplines. Each adds priorities,
      decision guidance, and checks to your task.
    </p>
    <a class="text-link" href="/docs/profiles/">
      How profiles work <Icon name="arrow-up-right" />
    </a>
  </section>
  <section class="wrap catalog-content">
    <CatalogBrowser items={items} groups={families} kind="profiles" />
  </section>
</Base>
