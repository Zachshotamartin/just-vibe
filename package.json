{
  "name": "just-vibe",
  "version": "0.10.0",
  "description": "Tools, skills, and commands for coding agents.",
  "homepage": "https://just-vibe-tools.vercel.app/",
  "type": "module",
  "bin": {
    "just-vibe": "bin/just-vibe.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:hosts": "node scripts/smoke-hosts.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "npm run validate && npm test",
    "setup": "node bin/just-vibe.mjs setup",
    "build:skills": "node scripts/build-skills.mjs",
    "eval:runtime": "node --test tests/scenarios.test.mjs",
    "release:check": "npm run check && node scripts/release-check.mjs",
    "test:package-managers": "node scripts/smoke-package-managers.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepublishOnly": "npm run release:check",
    "eval:behavior": "node evals/behavior/harness.mjs",
    "eval:benchmark": "node evals/benchmark/harness.mjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "eval:security": "node evals/security/run.mjs",
    "eval:conversation": "node evals/conversation/harness.mjs",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:test": "npm --prefix website test",
    "test:runtime-browser": "node scripts/smoke-runtime-browser.mjs",
    "test:canvas-browser": "node scripts/smoke-canvas-browser.mjs",
    "eval:hosts": "node scripts/eval-live-hosts.mjs",
    "audit:ecc": "node scripts/audit-ecc.mjs",
    "test:operator-browser": "node scripts/smoke-operator-browser.mjs",
    "check:localizations": "node scripts/check-localizations.mjs",
    "audit:implementation": "node scripts/check-ecc-implementation.mjs"
  },
  "files": [
    "bin/",
    "plugins/",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/",
    "evals/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zachshotamartin/just-vibe.git"
  },
  "author": "Zachary Martin",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
