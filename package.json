{
  "name": "just-vibe",
  "version": "0.2.0",
  "private": true,
  "description": "Tools, skills, and commands for coding agents.",
  "type": "module",
  "bin": {
    "just-vibe": "bin/just-vibe.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:hosts": "node scripts/smoke-hosts.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "npm run validate && npm test",
    "setup": "node bin/just-vibe.mjs setup",
    "build:skills": "node scripts/build-skills.mjs",
    "eval:runtime": "node --test tests/scenarios.test.mjs"
  },
  "files": [
    "bin/",
    "plugins/",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zachshotamartin/just-vibe.git"
  },
  "author": "Zachary Martin"
}
